{
  "security": [],
  "openapi": "3.0.0",
  "info": {
    "title": "Acme Corp E-Commerce API",
    "version": "2.0.0",
    "description": "Official API for managing users, product catalogs, and order fulfillment pipelines."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development Server"
    }
  ],
  "tags": [
    {
      "name": "E-Commerce Platform"
    }
  ],
  "components": {
    "schemas": {
      "GetApiProductsResponsedefaultDataItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "inventoryCount": {
            "type": "number"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "price",
          "currency",
          "inventoryCount",
          "categories"
        ]
      },
      "loginSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "User's registered email address"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "description": "User's password"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "registerSchema": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 2,
            "description": "User's first name"
          },
          "lastName": {
            "type": "string",
            "minLength": 2,
            "description": "User's last name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
            "description": "A valid corporate or personal email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "description": "A strong password (12+ characters)"
          },
          "company": {
            "description": "Company name, if applicable",
            "type": "string"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "createOrderSchema": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "ID of the product to order"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Number of items"
          },
          "shippingAddress": {
            "type": "object",
            "properties": {
              "line1": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "countryCode": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2
              },
              "postalCode": {
                "type": "string"
              }
            },
            "required": [
              "line1",
              "city",
              "countryCode",
              "postalCode"
            ],
            "additionalProperties": false,
            "description": "Destination address"
          }
        },
        "required": [
          "productId",
          "quantity",
          "shippingAddress"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api": {
      "get": {
        "summary": "Get Root",
        "responses": {
          "default": {
            "description": "Default fallback response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "E-Commerce Platform"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Authenticate User",
        "responses": {
          "default": {
            "description": "Generic status from T[\"status\"]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    },
                    "user": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "email"
                      ]
                    }
                  },
                  "required": [
                    "token",
                    "user"
                  ]
                }
              }
            }
          }
        },
        "description": "Authenticates a user and returns a signed JWT session token.",
        "tags": [
          "Authentication",
          "E-Commerce Platform"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/loginSchema"
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register New Account",
        "responses": {
          "201": {
            "description": "Status 201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "id": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "id",
                    "email"
                  ]
                }
              }
            }
          }
        },
        "description": "Provisions a new user account in the system and sends a verification email.",
        "tags": [
          "Authentication",
          "E-Commerce Platform"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/registerSchema"
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Logout User",
        "responses": {
          "default": {
            "description": "Generic status from T[\"status\"]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "message"
                  ]
                }
              }
            }
          }
        },
        "description": "Invalidates the current user session and clears authentication cookies.",
        "tags": [
          "Authentication",
          "E-Commerce Platform"
        ]
      }
    },
    "/api/products": {
      "get": {
        "summary": "List Catalog Products",
        "responses": {
          "default": {
            "description": "Generic status from T[\"status\"]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/GetApiProductsResponsedefaultDataItem"
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "number"
                        },
                        "limit": {
                          "type": "number"
                        },
                        "total": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "page",
                        "limit",
                        "total"
                      ]
                    }
                  },
                  "required": [
                    "data",
                    "meta"
                  ]
                }
              }
            }
          }
        },
        "description": "Returns a paginated list of all active products in the store catalog.",
        "tags": [
          "Catalog",
          "E-Commerce Platform"
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "inStock",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/products/{productId}": {
      "get": {
        "summary": "Retrieve Product Details",
        "responses": {
          "default": {
            "description": "Generic status from T[\"status\"]",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApiProductsResponsedefaultDataItem"
                }
              }
            }
          }
        },
        "description": "Fetches the full product details, including pricing and inventory data, by its unique ID.",
        "tags": [
          "Catalog",
          "E-Commerce Platform"
        ],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/orders": {
      "post": {
        "summary": "Create Order",
        "responses": {
          "201": {
            "description": "Status 201",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "orderId": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "estimatedShippingDate": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "success",
                    "orderId",
                    "status",
                    "estimatedShippingDate"
                  ]
                }
              }
            }
          }
        },
        "description": "Places a new order for a product and triggers the fulfillment pipeline.",
        "tags": [
          "Orders",
          "E-Commerce Platform"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createOrderSchema"
              }
            }
          }
        }
      }
    },
    "/api/orders/tracking/{trackingNumber}": {
      "get": {
        "summary": "Get Shipment Tracking",
        "responses": {
          "default": {
            "description": "Generic status from T[\"status\"]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trackingNumber": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "location": {
                      "type": "object",
                      "properties": {
                        "lat": {
                          "type": "number"
                        },
                        "lng": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "lat",
                        "lng"
                      ]
                    },
                    "estimatedDelivery": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "trackingNumber",
                    "status",
                    "location",
                    "estimatedDelivery"
                  ]
                }
              }
            }
          }
        },
        "description": "Fetches real-time GPS tracking data for a specific shipment.",
        "tags": [
          "Logistics",
          "E-Commerce Platform"
        ],
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/docs": {
      "get": {
        "summary": "Get Docs",
        "responses": {
          "default": {
            "description": "Generic status from T[\"status\"]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "E-Commerce Platform"
        ]
      }
    },
    "/api/docs/open-api": {
      "get": {
        "summary": "Get Docs Open api",
        "responses": {
          "default": {
            "description": "Generic status from T[\"status\"]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "tags": [
          "E-Commerce Platform"
        ]
      }
    }
  }
}
